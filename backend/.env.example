PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/hotelpro
# Required: generate a unique secret of at least 32 characters (for example: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))").
# Do not commit your generated value. The server refuses blank, short, or placeholder secrets.
JWT_SECRET=
JWT_EXPIRE=7d
CLIENT_URL=http://localhost:5173
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=no-reply@hotelpro.com
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=placeholder_secret_key
RAZORPAY_WEBHOOK_SECRET=
# Optional and development/demo only. Set to true to permit clearly labelled simulated payments.
# This is allowed only when NODE_ENV is development or test, and is always blocked in production.
DEMO_PAYMENT_MODE=false
UPLOAD_STORAGE_MODE=local
